@page "/"

<PageTitle>TopSpecs</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4">

    <MudPaper Elevation="0" Class="pa-8 mt-6 mb-4 rounded-lg mud-theme-primary">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.h4" Class="mb-3" Style="color: white;">
                    Alles zu deinen Gegenständen. An einem Ort.
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-6" Style="color: white;">
                    Egal ob du gerade in der Rennrad-Bubble, Photovoltaik-Bubble oder Gaming-Bubble bist: Verwalte deine Gegenstände,
                    hinterlege Details, Belege und Messwerte, behalte deinen Anschaffungsstatus im Blick –
                    und teile sie bei Bedarf direkt mit ChatGPT, Copilot &amp; Co.
                </MudText>
                <MudStack Row="true" Spacing="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Surface" Href="authentication/login">Kostenlos starten</MudButton>
                    <MudButton Variant="Variant.Text" Style="color: white;" Href="/">So funktioniert's</MudButton>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="5" Class="d-none d-md-flex justify-center align-center">
                <div class="bubble-animation">
                    @for (var i = 1; i <= 9; i++)
                    {
                        <div class="bubble bubble-@i"></div>
                    }
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-10">
        <MudGrid Justify="Justify.Center" Spacing="6">
            @foreach (var stat in Stats)
            {
                <MudItem xs="12" sm="6" lg="3">
                    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
                        <MudIcon Icon="@stat.Icon" Size="Size.Large" Color="Color.Secondary" />
                        <div>
                            <MudText Typo="Typo.subtitle2">@stat.Label</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@stat.Subtitle</MudText>
                        </div>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>

    <MudDivider Class="my-4" />

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-10">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Was bringt dir TopSpecs im Alltag?</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-10">
            Klare Infos, weniger Suchen, schneller teilen – genau dann, wenn es darauf ankommt.
        </MudText>

        <MudGrid Spacing="4">
            @foreach (var feature in Features)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="1" Class="pa-4" Style="height: 100%;">
                        <MudCardContent>
                            <MudIcon Icon="@feature.Icon" Size="Size.Medium" Color="Color.Primary" Class="mb-2" />
                            <MudText Typo="Typo.h6" Class="mb-1">@feature.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@feature.Description</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>

    <MudDivider Class="my-4" />

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-10">
        <MudGrid Spacing="6">
            <MudItem xs="12" lg="5">
                <MudText Typo="Typo.h5" Class="mb-3">Extra: Mit KI arbeiten – ohne Technikballast</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    Wenn du magst, bereitet TopSpecs Details, Informationen und Messwerte deiner Gegenstände so auf,
                    dass du sie direkt in KI-Tools verwenden kannst – ein optionales Extra, kein Pflichtschritt.
                </MudText>
            </MudItem>
            <MudItem xs="12" lg="7">
                <MudList Clickable="false" T="string">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Link">
                        <MudText Typo="Typo.subtitle2">KI-Links</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Speichere wiederkehrende Fragen als Link – ein Klick, alles ist vorbereitet.</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Hub">
                        <MudText Typo="Typo.subtitle2">MCP-Anbindung</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Verbinde deine Daten mit KI-Assistenten, damit relevante Infos direkt verfügbar sind.</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.FlashOn">
                        <MudText Typo="Typo.subtitle2">Sofort nutzbar</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Keine langen Vorbereitungen: kopieren, teilen und direkt mit der KI arbeiten.</MudText>
                    </MudListItem>
                </MudList>
            </MudItem>
        </MudGrid>
    </MudContainer>

    <MudDivider Class="my-4" />

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-10">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">So funktioniert TopSpecs</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-10">
            Einmal sauber erfassen – danach für Fragen, Service und optional auch KI direkt nutzbar.
        </MudText>

        <MudGrid Spacing="4">
            @foreach (var step in Steps)
            {
                <MudItem xs="12" md="6" lg="3">
                    <MudCard Elevation="1" Class="pa-4" Style="height: 100%;">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">@step.Number</MudText>
                            <MudText Typo="Typo.h6" Class="mb-1">@step.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@step.Description</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>

    <MudPaper Elevation="0" Class="pa-8 mb-8 rounded-lg mud-theme-primary">
        <MudContainer MaxWidth="MaxWidth.Medium">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudText Typo="Typo.h5" Align="Align.Center" Style="color: white;">Mehr Überblick, weniger Suchen</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Style="color: white;">
                    Starte jetzt kostenlos und bring Ordnung in alles, was dir wichtig ist.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Surface" Href="authentication/login">Jetzt kostenlos starten</MudButton>
            </MudStack>
        </MudContainer>
    </MudPaper>

</MudContainer>

@code {
    private static readonly FeatureItem[] Features =
    [
        new(Icons.Material.Filled.Inventory2, "Gegenstände verwalten", "Lege alle deine Gegenstände zentral an – vom Fahrrad über die Solaranlage bis zum Computer.", "/"),
        new(Icons.Material.Filled.EditNote, "Details & Belege hinterlegen", "Sammle Details, Fotos, Rechnungen und Notizen zentral, damit nichts verloren geht.", "/"),
        new(Icons.Material.Filled.Analytics, "Messwerte & Verlauf speichern", "Erfasse Messwerte, Werkstatt-Ergebnisse und Verläufe, um Zustand und Entwicklung im Blick zu behalten.", "/"),
        new(Icons.Material.Filled.ShoppingCartCheckout, "Wunschliste & Anschaffungsplanung", "Behalte im Blick, was du besitzt, gerade planst oder dir wünschst – vom Ersatzteil bis zum nächsten großen Kauf.", "/"),
        new(Icons.Material.Filled.Build, "Zustand im Blick behalten", "Ob aktiv genutzt, gerade in Reparatur oder verkauft: Der Status deiner Gegenstände bleibt immer aktuell.", "/"),
        new(Icons.Material.Filled.Hub, "KI-Anbindung als Extra", "Wenn gewünscht: Teile deine Daten strukturiert mit ChatGPT, Copilot & Co. – ganz ohne technischen Aufwand.", "/")
    ];

    private static readonly StatItem[] Stats =
    [
        new(Icons.Material.Filled.Inventory2, "Gegenstände", "Zentral verwaltet, jederzeit griffbereit"),
        new(Icons.Material.Filled.EditNote, "Details & Belege", "Nichts geht mehr verloren"),
        new(Icons.Material.Filled.Analytics, "Messwerte & Verlauf", "Zustand und Entwicklung im Blick"),
        new(Icons.Material.Filled.ShoppingCartCheckout, "Anschaffungsplanung", "Besitz, Planung und Wunschliste an einem Ort")
    ];

    private static readonly StepItem[] Steps =
    [
        new("1", "Gegenstand anlegen", "Lege zuerst einen Gegenstand an, z. B. Fahrrad, Solaranlage oder Computer."),
        new("2", "Merkmale, Status & Belege erfassen", "Trage Details, Fotos, Rechnungen und deinen Anschaffungsstatus ein – alles bleibt zentral und auffindbar."),
        new("3", "Verlauf pflegen", "Halte Messwerte, Wartungen und Änderungen über die Zeit fest."),
        new("4", "Optional mit KI teilen", "Erzeuge bei Bedarf eine KI-taugliche Zusammenfassung oder einen smarten Link.")
    ];

    private sealed record FeatureItem(string Icon, string Title, string Description, string Link);
    private sealed record StatItem(string Icon, string Label, string Subtitle);
    private sealed record StepItem(string Number, string Title, string Description);
}
