<MudNavMenu Class="nav-menu-white" Dense="false">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">Willkommen</MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="authentication/logout" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Logout">
                Abmelden
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="authentication/login" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Login">
                Anmelden
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
    <MudNavLink Href="/kontakt" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ContactSupport">Kontakt</MudNavLink>
</MudNavMenu>


<style>
    .nav-menu-white .mud-nav-link,
    .nav-menu-white .mud-nav-link .mud-icon-root {
        color: #fff !important;
    }
</style>
