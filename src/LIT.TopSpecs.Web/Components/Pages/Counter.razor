@page "/counter"

<PageTitle>Counter</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Counter</MudText>
<MudText Typo="Typo.body1" Class="mb-3">Current count: @_count</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Increment">Click me</MudButton>

@code {
    private int _count;

    private void Increment()
    {
        _count++;
    }
}
