@page "/"

<PageTitle>TopSpecs</PageTitle>

<MudPaper Elevation="0" Outlined="true" Class="pa-6">
    <MudStack Spacing="2">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Blazor + MudBlazor</MudChip>
        <MudText Typo="Typo.h3">Build better specs. Faster.</MudText>
        <MudText Typo="Typo.subtitle1">
            TopSpecs kombiniert moderne Blazor-UX mit klaren Workflows für Teams, die technische Qualität messbar verbessern wollen.
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/weather" StartIcon="@Icons.Material.Filled.PlayArrow">Live Demo</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Href="/counter" StartIcon="@Icons.Material.Filled.Bolt">Features</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

<MudGrid Spacing="3" Class="mt-4">
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Moderne Architektur</MudText>
                <MudText Typo="Typo.body2">Interactive WASM mit klarer Trennung von UI, UseCases und Infrastruktur.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Produktive UI</MudText>
                <MudText Typo="Typo.body2">Konsistente, responsive Komponenten direkt aus MudBlazor.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Skalierbarer Betrieb</MudText>
                <MudText Typo="Typo.body2">Service Defaults und Observability für stabile Deployments.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
